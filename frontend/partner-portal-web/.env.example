# Mock (default) or live data source for portal screens.
# Live is not wired yet — keep mock for Step 3 portal UI.
VITE_DATA_SOURCE=mock

# Zahy.Identity OpenIddict authority (the API host).
VITE_OIDC_AUTHORITY=https://localhost:44300

# Public SPA client id seeded in OpenIddict.
VITE_OIDC_CLIENT_ID=zahy-partner-web

# Space-separated scopes. openid/profile/email/roles/offline_access are required;
# resource scopes (e.g. catalog:read) make the access token valid for the API.
VITE_OIDC_SCOPE=openid profile email roles offline_access catalog:read orders:read partners:manage

# Backend API base URL (defaults to the authority if omitted).
VITE_API_BASE_URL=https://localhost:44300
